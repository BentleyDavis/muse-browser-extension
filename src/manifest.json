{
  "manifest_version": 3,
  "name": "Muse Browser Control",
  "version": "0.2.0",
  "description": "Real-time browser automation with human-like mouse movement",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"],
  "host_permissions": ["https://messages.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Muse Control"
  },
  "content_scripts": [
    {
      "matches": ["https://messages.google.com/*"],
      "js": ["config.local.js", "firebase.js", "recorder.js", "player.js", "archiver.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
